# ---------------------------------------------------------------------------
# Thunder UI environment
#
# Copy to `.env` (shared defaults) or `.env.development` / `.env.production` /
# `.env.mobile` (per-mode overrides). Vite only exposes variables prefixed
# `VITE_`. Every value is a string: boolean flags are read with `envFlag()` in
# src/core/lib/utils.ts, which treats 0/false/off/no as disabled.
# ---------------------------------------------------------------------------

# --- API -------------------------------------------------------------------
# Base URL of the Thunder Framework API. Defaults to window.location.origin.
VITE_API_BASE_URL=

# --- Auth ------------------------------------------------------------------
# Set VITE_OAUTH_CLIENT_ID to use OIDC. Leave it empty to use cookie sessions
# (/auth/api/get-session) instead -- see src/core/protected.tsx.
VITE_OAUTH_SERVER_URL=
VITE_OAUTH_CLIENT_ID=
VITE_OAUTH_SCOPE=full_access offline_access

# --- Layout ----------------------------------------------------------------
# One of: navbar (default), sidebar, mobile, native -- or any name you register
# in src/overrides/layouts.ts.
# `native` is one adaptive shell -- tab bar and gestures on a phone, sidebar on a
# desktop -- and is the one to use for the Capacitor build.
# Only the selected layout is bundled; the rest are never requested.
VITE_APP_LAYOUT=navbar

# --- Lists -----------------------------------------------------------------
# Page size for the card list view.
VITE_DEFAULT_PAGINATION_LIMIT=100

# SDK cache stale time, in SECONDS. Consumed by thunder-sdk. Falls back to 1,
# which effectively disables caching.
VITE_DEFAULT_CACHE_TTL=1

# --- Features --------------------------------------------------------------
# Built-in feature pages, all OFF by default. Set to 1 to enable.
# (These replace the old VITE_DISABLE_WALLET, which ran the opposite way.)
VITE_ENABLE_WALLET=
VITE_ENABLE_USERS=
VITE_ENABLE_NOTIFICATIONS=

# Fallback currency code when a wallet does not report one.
VITE_DEFAULT_CURRENCY=LYD

# --- Notifications ---------------------------------------------------------
# The triggers service that serves notifications. Both are required for the
# notification UI to appear.
VITE_TRIGGERS_BASE_URL=
VITE_TRIGGERS_TENANT_ID=

# Unread-count poll interval in MILLISECONDS. Defaults to 30000.
VITE_UNREAD_COUNT_INTERVAL=30000

# --- Uploads ---------------------------------------------------------------
# ImageKit folder for uploaded files. Empty uses the account default.
VITE_UPLOAD_FOLDER=
