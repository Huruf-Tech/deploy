# Thunder backend origin. Leave empty in production when the API serves the app.
VITE_API_ORIGIN=https://thunder.huruf-tech.deno.net

# ── Feature flags ─────────────────────────────────────────────────────────────
# Every feature is ON unless set to false / 0 / off / no. Values are inlined at
# build time, so rebuild after changing them. These only hide UI: the backend
# still enforces permissions, and sign-in methods come from its capabilities.

# Developers → OAuth apps
VITE_ENABLE_OAUTH_APPS=true
# Developers → API keys (the Developers section disappears if both are off)
VITE_ENABLE_API_KEYS=true
# Members & invitations (only shown when the URL has ?tenant=)
VITE_ENABLE_MEMBERS=true
# Security → Connected accounts (link / unlink social providers)
VITE_ENABLE_CONNECTED_ACCOUNTS=true
# Security → Your devices (active sessions, remote sign-out)
VITE_ENABLE_DEVICE_SESSIONS=true
# Personal info → edit name, gender, birthday and photo
VITE_ENABLE_PROFILE_EDITING=true
# Header controls
VITE_ENABLE_THEME_SWITCHER=true
VITE_ENABLE_LANGUAGE_SWITCHER=true
