{
  "version": 1,
  "headers": {
    "key": "X-Agent-Key",
    "timestamp": "X-Agent-Timestamp",
    "signature": "X-Agent-Signature",
    "protocol": "X-Agent-Protocol"
  },
  "schemas": {
    "HelloRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "tenant": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "signPublicKey": {
          "type": "string",
          "maxLength": 100,
          "description": "Ed25519, raw, base64url"
        },
        "boxPublicKey": {
          "type": "string",
          "maxLength": 100,
          "description": "X25519, raw, base64url"
        },
        "inventory": {
          "type": "object",
          "properties": {
            "hostname": {
              "type": "string",
              "maxLength": 255
            },
            "os": {
              "type": "string",
              "maxLength": 100
            },
            "arch": {
              "type": "string",
              "enum": [
                "amd64",
                "arm64"
              ]
            },
            "cpuCores": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "memory": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Bytes"
            },
            "disk": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Bytes"
            },
            "publicIp": {
              "type": "string",
              "maxLength": 64
            },
            "privateIp": {
              "type": "string",
              "maxLength": 64
            },
            "dockerVersion": {
              "type": "string",
              "maxLength": 50
            },
            "agentVersion": {
              "type": "string",
              "maxLength": 50
            }
          },
          "required": [
            "hostname",
            "os",
            "arch",
            "cpuCores",
            "memory",
            "disk",
            "agentVersion"
          ]
        },
        "joinToken": {
          "description": "One-time token from the SSH wizard: activates the server without pairing",
          "type": "string",
          "maxLength": 100
        }
      },
      "required": [
        "tenant",
        "signPublicKey",
        "boxPublicKey",
        "inventory"
      ]
    },
    "HelloResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "properties": {
            "poll": {
              "type": "object",
              "properties": {
                "idleMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "activeMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "terminalMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "idleMs",
                "activeMs",
                "terminalMs"
              ],
              "additionalProperties": false
            },
            "jitterPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "summaryIntervalMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maxBackoffMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "poll",
            "jitterPercent",
            "summaryIntervalMs",
            "maxBackoffMs"
          ],
          "additionalProperties": false
        },
        "server": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "active",
            "rejected"
          ]
        },
        "pairingCode": {
          "type": "string"
        },
        "pairingExpiresAt": {
          "type": "string"
        },
        "nextPollMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "version",
        "config",
        "server",
        "status",
        "nextPollMs"
      ],
      "additionalProperties": false
    },
    "AgentConfigResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "properties": {
            "poll": {
              "type": "object",
              "properties": {
                "idleMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "activeMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "terminalMs": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "idleMs",
                "activeMs",
                "terminalMs"
              ],
              "additionalProperties": false
            },
            "jitterPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 50
            },
            "summaryIntervalMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maxBackoffMs": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "poll",
            "jitterPercent",
            "summaryIntervalMs",
            "maxBackoffMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "config"
      ],
      "additionalProperties": false
    },
    "PollRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "commandCursor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "appliedVersion": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "summary": {
          "description": "Sent at most every 60 s, or on a >10% change",
          "type": "object",
          "properties": {
            "cpu": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Used fraction"
            },
            "memFree": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "diskFree": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "cpu",
            "memFree",
            "diskFree"
          ]
        },
        "streams": {
          "description": "Open terminals: session -> highest input seq applied. Only sent while one is open",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "commandCursor"
      ]
    },
    "PollResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "nextPollMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "configVersion": {
          "type": "string"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "enum": [
                  "ping",
                  "docker.ensure",
                  "stream.open",
                  "stream.close"
                ]
              },
              "payload": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "seq",
              "type",
              "payload"
            ],
            "additionalProperties": false
          }
        },
        "streamInput": {
          "description": "New terminal input per session, after the cursors in `streams`",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "data": {
                  "type": "string",
                  "maxLength": 16384
                },
                "cols": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 1000
                },
                "rows": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 500
                }
              },
              "required": [
                "seq"
              ],
              "additionalProperties": false
            }
          }
        }
      },
      "required": [
        "nextPollMs",
        "configVersion",
        "commands"
      ],
      "additionalProperties": false
    },
    "PollRefusal": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "rejected",
            "unknown"
          ]
        },
        "nextPollMs": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "configVersion": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "nextPollMs",
        "configVersion"
      ],
      "additionalProperties": false
    },
    "CommandResultEvent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "command.result"
        },
        "data": {
          "type": "object",
          "properties": {
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "ok": {
              "type": "boolean"
            },
            "result": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "error": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "seq",
            "ok"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ]
    },
    "StreamChunkEvent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "stream.chunk"
        },
        "data": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "data": {
              "type": "string",
              "maxLength": 65536
            },
            "done": {
              "description": "The stream ended (exec finished)",
              "type": "boolean"
            },
            "error": {
              "type": "string",
              "maxLength": 500
            }
          },
          "required": [
            "session",
            "seq",
            "data"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ]
    },
    "EventsResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "applied": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "close": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stream sessions nobody is watching any more: stop them"
        }
      },
      "required": [
        "applied",
        "close"
      ],
      "additionalProperties": false
    },
    "StreamOpenPayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "logs",
            "metrics",
            "exec",
            "terminal"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "maxBytesPerSec": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 9007199254740991,
          "description": "Output above this rate is dropped and marked as truncated"
        }
      },
      "required": [
        "session",
        "kind",
        "params",
        "maxBytesPerSec"
      ],
      "additionalProperties": false
    },
    "StreamClosePayload": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        }
      },
      "required": [
        "session"
      ],
      "additionalProperties": false
    },
    "MetricsSample": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "t": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Unix time in milliseconds"
        },
        "cpu": {
          "type": "number",
          "description": "Used fraction, 0..1"
        },
        "memUsed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "memTotal": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "diskUsed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "diskTotal": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "netRx": {
          "type": "number",
          "description": "Bytes per second"
        },
        "netTx": {
          "type": "number",
          "description": "Bytes per second"
        },
        "containers": {
          "description": "Live samples only; history points omit it",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "image": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "cpu": {
                "type": "number",
                "description": "Used fraction of one host, 0..1"
              },
              "mem": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "image",
              "state",
              "cpu",
              "mem"
            ]
          }
        }
      },
      "required": [
        "t",
        "cpu",
        "memUsed",
        "memTotal",
        "diskUsed",
        "diskTotal",
        "netRx",
        "netTx"
      ]
    },
    "EventsRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "events": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "type": "string",
                    "const": "command.result"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "seq": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "ok": {
                        "type": "boolean"
                      },
                      "result": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "error": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "seq",
                      "ok"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "data"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "type": {
                    "type": "string",
                    "const": "stream.chunk"
                  },
                  "data": {
                    "type": "object",
                    "properties": {
                      "session": {
                        "type": "string"
                      },
                      "seq": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "data": {
                        "type": "string",
                        "maxLength": 65536
                      },
                      "done": {
                        "description": "The stream ended (exec finished)",
                        "type": "boolean"
                      },
                      "error": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "session",
                      "seq",
                      "data"
                    ]
                  }
                },
                "required": [
                  "id",
                  "type",
                  "data"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "events"
      ]
    }
  }
}
